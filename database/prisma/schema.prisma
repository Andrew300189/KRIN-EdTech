  status                LearningGroupStatus @default(DRAFT)
  startDate             DateTime?
  endDate               DateTime?
  timeZone              String              @default("UTC")
  maxStudents           Int?
  inviteCode            String?             @unique
  inviteCodeExpiresAt   DateTime?
