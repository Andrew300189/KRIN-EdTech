  reviewMaterials AssignmentReviewMaterial[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([groupId, dueAt])
  @@index([studentId, dueAt])
  @@index([teacherId, status])
}

model AssignmentSubmission {
  id           String                   @id @default(cuid())
  assignmentId String
  assignment   Assignment               @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                     @relation("AssignmentSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status       AssignmentSubmissionStatus @default(NOT_STARTED)
  content      Json?
  submittedAt  DateTime?
  score        Int?
  autoScore    Int?
  teacherScore Int?
  feedback     String?
  reviewedById String?
  reviewedBy   User?                    @relation("AssignmentSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId, status])
}

model TeacherStudentNote {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    User           @relation("TeacherStudentNoteTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  studentId  String
  student    User           @relation("TeacherStudentNoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String?
  group      LearningGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  content    String
  visibility TeacherNoteVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([teacherId, studentId, createdAt])
  @@index([studentId, visibility])
}

model AssignmentReviewMaterial {
  id          String         @id @default(cuid())
  assignmentId String?
  assignment  Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId     String?
  group       LearningGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
