// Prisma schema for KRIN-EdTech.
// The legacy generic course level is retained only for a lossless migration.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-client-payments-runtime"
}

model User {
  id                           String                      @id @default(cuid())
  email                        String                      @unique
  username                     String                      @unique
  name                         String
  firstName                    String?
  lastName                     String?
  passwordHash                 String
  avatar                       String?
  interfaceLanguage            String                      @default("en")
  timeZone                     String                      @default("UTC")
  country                      String?
  provider                     String?
  providerAccountId            String?
  stripeCustomerId             String?                     @unique
  subscriptionPlan             SubscriptionPlan            @default(FREE)
  subscriptionStatus           SubscriptionStatus          @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  role                         Role                        @default(STUDENT)
  isBlocked                    Boolean                     @default(false)
  deletedAt                    DateTime?
  emailVerified                Boolean                     @default(false)
  emailVerificationToken       String?
  emailVerificationSentAt      DateTime?
  targetLanguage               String?
  learningGoal                 String?
  currentLevel                 Level?
  dailyIntensityMinutes        Int?
  dailyGoalMinutes             Int                         @default(15)
  takePlacementTest            Boolean                     @default(false)
  onboardingCompletedAt        DateTime?
  welcomeBonusPoints           Int                         @default(0)
  guidedTourCompleted          Boolean                     @default(false)
  lastLoginAt                  DateTime?
  teacherProfile               TeacherProfile?
  ownedLearningGroups          LearningGroup[]            @relation("LearningGroupOwner")
  groupTeachingMemberships     GroupTeacher[]             @relation("GroupTeacherUser")
  groupStudentMemberships      GroupStudent[]             @relation("GroupStudentUser")
  sentGroupInvitations         GroupInvitation[]          @relation("GroupInvitationInviter")
  invitationStudentRecords     GroupInvitation[]          @relation("GroupInvitationStudent")
  studentCourses               StudentCourse[]
  assignedCoursesAsTeacher     StudentCourseAssignment[]  @relation("StudentCourseAssignmentTeacher")
  assignedCoursesAsStudent     StudentCourseAssignment[]  @relation("StudentCourseAssignmentStudent")
  groupCourseAssignments       GroupCourseAssignment[]    @relation("GroupCourseAssignmentAssigner")
  authoredAssignments          Assignment[]               @relation("AssignmentTeacher")
  assignedAssignments          Assignment[]               @relation("AssignmentStudent")
  assignmentSubmissions        AssignmentSubmission[]     @relation("AssignmentSubmissionStudent")
  reviewedAssignmentSubmissions AssignmentSubmission[]    @relation("AssignmentSubmissionReviewer")
  teacherNotesWritten          TeacherStudentNote[]       @relation("TeacherStudentNoteTeacher")
  teacherNotesReceived         TeacherStudentNote[]       @relation("TeacherStudentNoteStudent")
  reviewMaterials              AssignmentReviewMaterial[] @relation("AssignmentReviewMaterialAuthor")
  authoredCourses              Course[]                    @relation("CourseInstructor")
  enrolledCourses              Course[]                    @relation("CourseStudents")
  sessions                     Session[]
  subscriptions                Subscription[]
  payments                     Payment[]
  orders                       Order[]
  coursePurchases              CoursePurchase[]
  entitlements                 Entitlement[]
  promotionRedemptions         PromotionRedemption[]
  lessonProgress               LessonProgress[]
  exerciseAttempts             ExerciseAttempt[]
  mistakes                     UserMistake[]
  userWords                    UserWord[]
  userCustomWords              UserCustomWord[]
  wordReviewAttempts           WordReviewAttempt[]
  vocabularyTrainingSessions   VocabularyTrainingSession[]
  vocabularySettings           UserVocabularySettings?
  vocabularyImportLogs         VocabularyImportLog[]
  learningActivities           LearningActivity[]
  learningSessions             LearningSession[]
  dailyActivities              UserDailyActivity[]
  experienceTransactions       ExperienceTransaction[]
  wallet                       UserWallet?
  userLevelProgress            UserLevel?
  streak                       UserStreak?
  streakEvents                 StreakEvent[]
  achievements                 UserAchievement[]
  suspiciousActivities         SuspiciousActivity[]
  homeworkSubmissions          HomeworkSubmission[]
  contentAuditLogs             ContentAuditLog[]           @relation("ContentAuditActor")
  notificationSettings         UserNotificationSettings?
  notificationPreferences      UserNotificationPreference[]
  notifications                Notification[]
  notificationDeliveries       NotificationDelivery[]
  notificationEvents           NotificationEvent[]
  pushSubscriptions            PushSubscription[]
  supportTickets               SupportTicket[]             @relation("SupportTicketRequester")
  assignedSupportTickets       SupportTicket[]             @relation("SupportTicketAssignee")
  supportMessages              SupportMessage[]            @relation("SupportMessageAuthor")
  supportStatusChanges         SupportTicketStatusHistory[] @relation("SupportStatusActor")
  supportAttachments           SupportAttachment[]         @relation("SupportAttachmentUploader")
  supportRatings               SupportRating[]
  helpArticles                 HelpArticle[]               @relation("HelpArticleAuthor")
  announcements                SystemAnnouncement[]        @relation("AnnouncementAuthor")
  supportTeamMemberships       SupportTeamMember[]
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  CoinTransaction              CoinTransaction[]

  @@unique([provider, providerAccountId])
}

model LanguageLevel {
  id          String    @id @default(cuid())
  code        CefrLevel @unique
  title       String
  description String
  order       Int       @unique
  isPublished Boolean   @default(false)
  courses     Course[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CourseCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  coverImage  String?
  order       Int      @unique
  isPublished Boolean  @default(false)
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

model Course {
  id                   String             @id @default(cuid())
  levelId              String
  level                LanguageLevel      @relation(fields: [levelId], references: [id], onDelete: Restrict)
  categoryId           String
  category             CourseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug                 String             @unique
  title                String
  shortDescription     String             @map("description")
  fullDescription      String?
  coverImage           String?
  trailerVideoUrl      String?
  language             String             @default("en")
  estimatedDuration    Int                @default(0)
  lessonCount          Int                @default(0)
  difficulty           String?
  isPublished          Boolean            @default(false)
  isFeatured           Boolean            @default(false)
  firstFreeLessonCount Int                @default(0)
  priceAmount          Int?
  priceCurrency        String             @default("USD")
  learningOutcomes     Json?
  prerequisites        Json?
  accessPlan           SubscriptionPlan   @default(FREE)
  // Backwards-compatible mapping for the previous three-band curriculum.
  legacyLevel          Level              @default(BEGINNER) @map("level")
  academySlug          String             @default("general-english")
  pathSlug             String             @default("core-journey")
  stageSlug            String             @default("all-levels")
  instructor           User               @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId         String
  students             User[]             @relation("CourseStudents")
  groupAssignments     GroupCourseAssignment[]
  studentAssignments   StudentCourseAssignment[]
  studentCourses       StudentCourse[]
  assignments          Assignment[]
  modules              CourseModule[]
  learningActivities   LearningActivity[]
  learningSessions     LearningSession[]
  commerceProducts     Product[]
  coursePurchases      CoursePurchase[]
  entitlements         Entitlement[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([levelId, isPublished])
  @@index([categoryId, isPublished])
  @@index([instructorId, createdAt])
  @@index([accessPlan, isPublished])
}

model CourseModule {
  id               String        @id @default(cuid())
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  order            Int
  isPublished      Boolean       @default(false)
  lessons          Lesson[]
  commerceProducts Product[]
  entitlements     Entitlement[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([courseId, order])
  @@index([courseId, isPublished])
}

model Lesson {
  id                 String                      @id @default(cuid())
  moduleId           String
  module             CourseModule                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug               String                      @unique
  title              String
  description        String?
  // Preserved so legacy lessons retain their original category.
  type               LessonType
  order              Int
  estimatedDuration  Int                         @default(0)
  phraseOfTheDay     String?
  motivationalQuote  String?
  learningObjectives Json?
  previewText        String?
  isPublished        Boolean                     @default(false)
  isFree             Boolean                     @default(false)
  blocks             LessonBlock[]
  progress           LessonProgress[]
  exerciseAttempts   ExerciseAttempt[]
  mistakes           UserMistake[]
  vocabulary         LessonVocabulary[]
  vocabularySources  UserWord[]                  @relation("UserWordSourceLesson")
  vocabularySessions VocabularyTrainingSession[] @relation("WarmUpLesson")
  learningActivities LearningActivity[]
  learningSessions   LearningSession[]
  assignments        Assignment[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([moduleId, order])
  @@index([moduleId, isPublished])
}

model LessonBlock {
  id                  String               @id @default(cuid())
  lessonId            String
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type                LessonBlockType
  title               String?
  content             Json?
  settings            Json?
  order               Int
  isRequired          Boolean              @default(false)
  exercises           Exercise[]
  homeworkSubmissions HomeworkSubmission[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId, type])
}

model GrammarTopic {
  id          String    @id @default(cuid())
  title       String
  slug        String
  cefrLevel   CefrLevel
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([cefrLevel, slug])
  @@index([cefrLevel, order])
}

model Word {
  id                    String              @id @default(cuid())
  lemma                 String
  normalizedLemma       String
  partOfSpeech          WordPartOfSpeech?
  cefrLevel             CefrLevel?
  britishTranscription  String?
  americanTranscription String?
  britishAudioUrl       String?
  americanAudioUrl      String?
  frequencyRank         Int?
  isPhrasalVerb         Boolean             @default(false)
  isIdiomatic           Boolean             @default(false)
  isSlang               Boolean             @default(false)
  isActive              Boolean             @default(true)
  wordFormation         String?
  etymology             String?
  meanings              WordMeaning[]
  userWords             UserWord[]
  lessonVocabulary      LessonVocabulary[]
  sourceRelations       WordRelation[]      @relation("WordRelationSource")
  targetRelations       WordRelation[]      @relation("WordRelationTarget")
  examples              WordExample[]
  collocations          WordCollocation[]
  reviewAttempts        WordReviewAttempt[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([normalizedLemma, partOfSpeech])
  @@index([normalizedLemma])
  @@index([cefrLevel])
  @@index([partOfSpeech])
}

model WordMeaning {
  id          String   @id @default(cuid())
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  definition  String
  translation String?
  article     String?
  context     String?
  usageLabel  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model WordRelation {
  id           String           @id @default(cuid())
  sourceWordId String
  targetWordId String
  sourceWord   Word             @relation("WordRelationSource", fields: [sourceWordId], references: [id], onDelete: Cascade)
  targetWord   Word             @relation("WordRelationTarget", fields: [targetWordId], references: [id], onDelete: Cascade)
  type         WordRelationType
  note         String?
  createdAt    DateTime         @default(now())

  @@unique([sourceWordId, targetWordId, type])
  @@index([sourceWordId, type])
  @@index([targetWordId, type])
}

model WordExample {
  id          String     @id @default(cuid())
  wordId      String
  word        Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentence    String
  translation String?
  source      String?
  cefrLevel   CefrLevel?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model WordCollocation {
  id          String   @id @default(cuid())
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  value       String
  translation String?
  example     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model LessonVocabulary {
  id         String               @id @default(cuid())
  lessonId   String
  wordId     String
  lesson     Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word       Word                 @relation(fields: [wordId], references: [id], onDelete: Restrict)
  role       LessonVocabularyRole @default(NEW)
  order      Int
  isRequired Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@unique([lessonId, wordId])
  @@unique([lessonId, order])
  @@index([wordId])
}

model Exercise {
  id                 String             @id @default(cuid())
  lessonBlockId      String
  lessonBlock        LessonBlock        @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)
  type               ExerciseType
  instruction        String
  question           String
  content            Json?
  correctAnswer      Json
  alternativeAnswers Json?
  explanation        String?
  hint               String?
  difficulty         Int                @default(1)
  basePoints         Int                @default(1)
  timeLimitSeconds   Int?
  solutionCost       Int                @default(0)
  allowInstantCheck  Boolean            @default(true)
  allowExtraExercise Boolean            @default(false)
  order              Int
  attempts           ExerciseAttempt[]
  mistakes           UserMistake[]
  learningActivities LearningActivity[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([lessonBlockId, order])
  @@index([lessonBlockId, type])
}

model LessonProgress {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status            LessonProgressStatus @default(STARTED)
  completedBlocks   Json?
  currentBlockId    String?
  completionPercent Int                  @default(0)
  score             Int                  @default(0)
  grade             Int?
  correctAnswers    Int                  @default(0)
  incorrectAnswers  Int                  @default(0)
  activeSeconds     Int                  @default(0)
  startedAt         DateTime             @default(now())
  lastSeenAt        DateTime             @default(now())
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId, status])
  @@index([userId, lastSeenAt])
}

model ExerciseAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submittedAnswer  Json
  isCorrect        Boolean
  scoreAwarded     Int      @default(0)
  timeSpentSeconds Int?
  hintUsed         Boolean  @default(false)
  solutionOpened   Boolean  @default(false)
  attemptNumber    Int
  idempotencyKey   String?
  createdAt        DateTime @default(now())

  @@unique([userId, exerciseId, attemptNumber])
  @@unique([userId, exerciseId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([exerciseId, createdAt])
  @@index([lessonId, createdAt])
}

model HomeworkSubmission {
  id            String      @id @default(cuid())
  lessonBlockId String
  lessonBlock   LessonBlock @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Json?
  score         Int         @default(0)
  grade         Int?
  status        String      @default("DRAFT")
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([lessonBlockId, userId])
  @@index([userId, status, updatedAt])
}

model UserMistake {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String?
  exercise        Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submittedAnswer Json?
  expectedAnswer  Json?
  explanation     String?
  occurrenceCount Int       @default(1)
  lastOccurredAt  DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, resolvedAt, lastOccurredAt])
  @@index([exerciseId, userId])
}

model UserWord {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId            String?
  word              Word?                    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  customWord        String?
  customTranslation String?
  sourceLessonId    String?
  sourceLesson      Lesson?                  @relation("UserWordSourceLesson", fields: [sourceLessonId], references: [id], onDelete: SetNull)
  status            UserWordStatus           @default(NEW)
  masteryLevel      Int                      @default(0)
  easeFactor        Float                    @default(2.5)
  intervalDays      Int                      @default(0)
  repetitions       Int                      @default(0)
  lapses            Int                      @default(0)
  nextReviewAt      DateTime?
  lastReviewedAt    DateTime?
  correctCount      Int                      @default(0)
  incorrectCount    Int                      @default(0)
  isDifficult       Boolean                  @default(false)
  addedAt           DateTime                 @default(now())
  masteredAt        DateTime?
  archivedAt        DateTime?
  reviewAttempts    WordReviewAttempt[]
  trainingItems     VocabularyTrainingItem[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@index([userId, masteryLevel])
  @@index([wordId])
}

model UserCustomWord {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term           String
  normalizedTerm String
  translation    String
  partOfSpeech   WordPartOfSpeech?
  example        String?
  note           String?
  status         UserWordStatus           @default(NEW)
  masteryLevel   Int                      @default(0)
  easeFactor     Float                    @default(2.5)
  intervalDays   Int                      @default(0)
  repetitions    Int                      @default(0)
  lapses         Int                      @default(0)
  correctCount   Int                      @default(0)
  incorrectCount Int                      @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  archivedAt     DateTime?
  isDifficult    Boolean                  @default(false)
  reviewAttempts WordReviewAttempt[]
  trainingItems  VocabularyTrainingItem[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([userId, normalizedTerm])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
}

model WordReviewAttempt {
  id                   String                 @id @default(cuid())
  userId               String
  userWordId           String?
  userCustomWordId     String?
  wordId               String?
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord             UserWord?              @relation(fields: [userWordId], references: [id], onDelete: SetNull)
  userCustomWord       UserCustomWord?        @relation(fields: [userCustomWordId], references: [id], onDelete: SetNull)
  word                 Word?                  @relation(fields: [wordId], references: [id], onDelete: SetNull)
  exerciseType         VocabularyExerciseType
  submittedAnswer      Json
  isCorrect            Boolean
  quality              WordReviewQuality
  responseTimeSeconds  Int?
  previousIntervalDays Int
  nextIntervalDays     Int
  previousMasteryLevel Int
  nextMasteryLevel     Int
  reviewedAt           DateTime               @default(now())

  @@index([userId, reviewedAt])
  @@index([userWordId, reviewedAt])
  @@index([userCustomWordId, reviewedAt])
}

model VocabularyTrainingSession {
  id                 String                   @id @default(cuid())
  userId             String
  lessonId           String?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson?                  @relation("WarmUpLesson", fields: [lessonId], references: [id], onDelete: SetNull)
  status             VocabularySessionStatus  @default(CREATED)
  source             VocabularySessionSource
  totalItems         Int                      @default(0)
  completedItems     Int                      @default(0)
  correctItems       Int                      @default(0)
  incorrectItems     Int                      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  skippedAt          DateTime?
  items              VocabularyTrainingItem[]
  learningActivities LearningActivity[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId, status])
  @@index([userId, source, createdAt])
  @@index([lessonId, userId])
}

model VocabularyTrainingItem {
  id               String                       @id @default(cuid())
  sessionId        String
  userWordId       String?
  userCustomWordId String?
  session          VocabularyTrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userWord         UserWord?                    @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  userCustomWord   UserCustomWord?              @relation(fields: [userCustomWordId], references: [id], onDelete: Cascade)
  exerciseType     VocabularyExerciseType
  payload          Json
  answerKey        Json
  order            Int
  status           VocabularyTrainingItemStatus @default(PENDING)
  submittedAt      DateTime?
  createdAt        DateTime                     @default(now())

  @@unique([sessionId, order])
  @@index([sessionId, status])
}

model UserVocabularySettings {
  userId                     String    @id
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGoal                  Int       @default(10)
  maxSessionSize             Int       @default(20)
  showTranscription          Boolean   @default(true)
  autoplayAudio              Boolean   @default(false)
  pronunciationVariant       String    @default("BOTH")
  includeDifficultWords      Boolean   @default(true)
  dailyReminderEnabled       Boolean   @default(true)
  translationLanguage        String    @default("ru")
  lastReviewPromptAt         DateTime?
  reviewPromptDismissedUntil DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model WarmUpConfiguration {
  id                String   @id @default("default")
  minItems          Int      @default(1)
  maxItems          Int      @default(10)
  isRequired        Boolean  @default(false)
  maxPreviousWords  Int      @default(3)
  maxDueWords       Int      @default(3)
  maxDifficultWords Int      @default(2)
  maxGrammarItems   Int      @default(2)
  timeLimitSeconds  Int      @default(300)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model VocabularyImportLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  format       String
  totalRows    Int
  importedRows Int
  skippedRows  Int
  errors       Json?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
}

model LearningActivity {
  id                  String                     @id @default(cuid())
  userId              String
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                LearningActivityType
  courseId            String?
  course              Course?                    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId            String?
  lesson              Lesson?                    @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  exerciseId          String?
  exercise            Exercise?                  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  vocabularySessionId String?
  vocabularySession   VocabularyTrainingSession? @relation(fields: [vocabularySessionId], references: [id], onDelete: SetNull)
  durationSeconds     Int                        @default(0)
  score               Int                        @default(0)
  metadata            Json?
  occurredAt          DateTime                   @default(now())
  createdAt           DateTime                   @default(now())

  @@index([userId, occurredAt])
  @@index([lessonId, occurredAt])
  @@index([courseId, occurredAt])
}

model LearningSession {
  id                   String                @id @default(cuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId             String?
  course               Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId             String?
  lesson               Lesson?               @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  type                 LearningSessionType
