  endsAt       DateTime?
  usageLimit   Int?
  perUserLimit Int                   @default(1)
  isActive     Boolean               @default(true)
  redemptions  PromotionRedemption[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([code, isActive])
}

model PromotionRedemption {
  id             String    @id @default(cuid())
  promotionId    String
