model Assignment {
  id              String           @id @default(cuid())
  teacherId       String
  teacher         User             @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  groupId         String?
  group           LearningGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  studentId       String?
  student         User?            @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: SetNull)
  courseId        String?
