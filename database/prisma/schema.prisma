  @@index([userId, achievementId])
}

model SuspiciousActivity {
  id         String                     @id @default(cuid())
  userId     String
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       SuspiciousActivityType
  severity   SuspiciousActivitySeverity @default(LOW)
  metadata   Json?
  status     SuspiciousActivityStatus   @default(OPEN)
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime                   @default(now())

  @@index([userId, createdAt])
  @@index([status, severity, createdAt])
}

model ContentAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("ContentAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

/// Immutable snapshots used by the CMS to provide a safe change history and
/// restore point without duplicating the primary course, lesson or exercise
/// models. The entity still lives in its domain table; this model records the
/// state that was changed.
model CmsContentVersion {
  id         String                  @id @default(cuid())
  entityType CmsContentEntityType
  entityId   String
  version    Int
  action     CmsContentVersionAction
  snapshot   Json
  note       String?
  actorId    String?
  actor      User?                   @relation("CmsContentVersionActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime                @default(now())

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// Metadata for media already stored by an approved storage provider. Binary
/// uploads are deliberately kept out of the Next.js process; the CMS stores a
/// validated reference, accessibility metadata and ownership instead.
model CmsMediaAsset {
  id           String            @id @default(cuid())
  kind         CmsMediaAssetKind
  url          String
  storageKey   String?
  fileName     String
  mimeType     String
  sizeBytes    Int?
  width        Int?
  height       Int?
  durationMs   Int?
  altText      String?
  caption      String?
  metadata     Json?
  isArchived   Boolean           @default(false)
  uploadedById String
  uploadedBy   User              @relation("CmsMediaAssetUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  links        CmsContentMedia[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([url])
  @@index([kind, isArchived, createdAt])
  @@index([uploadedById, createdAt])
}

/// Polymorphic links keep media reusable between course cards, lesson blocks,
/// landing-page slots and dashboard cards without copying file metadata.
model CmsContentMedia {
  id         String               @id @default(cuid())
  entityType CmsContentEntityType
  entityId   String
  mediaId    String
  media      CmsMediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  role       String               @default("inline")
  order      Int                  @default(0)
  altText    String?
  createdAt  DateTime             @default(now())

  @@unique([entityType, entityId, mediaId, role])
  @@index([entityType, entityId, order])
}

/// CMS-managed JSON slots let the owner control selected homepage and role
/// dashboard sections without putting a second page system next to App Router.
model CmsContentSlot {
  id            String           @id @default(cuid())
  key           String           @unique
  area          CmsContentArea
  title         String
  content       Json
  contentStatus CmsContentStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdById   String
  createdBy     User             @relation("CmsContentSlotCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String
  updatedBy     User             @relation("CmsContentSlotUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([area, contentStatus, scheduledAt])
}

model UserNotificationSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale              String   @default("en")
  timezone            String   @default("UTC")
  inAppEnabled        Boolean  @default(true)
  emailEnabled        Boolean  @default(true)
  webPushEnabled      Boolean  @default(false)
  learningEnabled     Boolean  @default(true)
  vocabularyEnabled   Boolean  @default(true)
  motivationEnabled   Boolean  @default(true)
  billingEnabled      Boolean  @default(true)
  supportEnabled      Boolean  @default(true)
  marketingEnabled    Boolean  @default(false)
  systemEnabled       Boolean  @default(true)
  quietHoursEnabled   Boolean  @default(false)
  quietHoursStart     String?
  quietHoursEnd       String?
  dailyDigestEnabled  Boolean  @default(false)
  weeklyDigestEnabled Boolean  @default(false)
  dailyReminderTime   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model UserNotificationPreference {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationType NotificationType
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, notificationType, channel])
  @@index([userId, notificationType])
}

model NotificationEvent {
  id             String                  @id @default(cuid())
  type           NotificationType
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType     String?
  entityId       String?
  payload        Json?
  idempotencyKey String                  @unique
  status         NotificationEventStatus @default(RECEIVED)
  occurredAt     DateTime                @default(now())
  processedAt    DateTime?
  errorMessage   String?
  notification   Notification?
  createdAt      DateTime                @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id          String                 @id @default(cuid())
  eventId     String?                @unique
  event       NotificationEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  category    NotificationCategory
  priority    NotificationPriority   @default(NORMAL)
  title       String
  message     String
  actionUrl   String?
  actionLabel String?
  imageUrl    String?
  payload     Json?
  status      NotificationStatus     @default(ACTIVE)
  readAt      DateTime?
  seenAt      DateTime?
  expiresAt   DateTime?
  deliveries  NotificationDelivery[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, status])
  @@index([expiresAt])
}

/// A single server-side cursor per CMS owner. Platform notifications are
/// calculated from real domain events instead of duplicating every new user,
/// purchase or support request into a second high-volume event table.
model CmsNotificationReadState {
  id         String   @id @default(cuid())
  ownerId    String   @unique
  owner      User     @relation("CmsNotificationReadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  provider          String?
  providerMessageId String?
  status            NotificationDeliveryStatus @default(QUEUED)
  attemptCount      Int                        @default(0)
  scheduledAt       DateTime                   @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  failedAt          DateTime?
  failureCode       String?
  failureMessage    String?
  idempotencyKey    String                     @unique
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([notificationId, channel])
  @@index([status, scheduledAt])
  @@index([userId, createdAt])
}

model NotificationTemplate {
  id               String              @id @default(cuid())
  code             String
  channel          NotificationChannel
  locale           String
  subject          String?
  title            String
  body             String
  htmlBody         String?
