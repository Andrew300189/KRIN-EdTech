  incorrectItems     Int                      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  skippedAt          DateTime?
  items              VocabularyTrainingItem[]
  learningActivities LearningActivity[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([userId, status])
  @@index([userId, source, createdAt])
  @@index([lessonId, userId])
}

model VocabularyTrainingItem {
  id               String                       @id @default(cuid())
  sessionId        String
  userWordId       String?
  userCustomWordId String?
  session          VocabularyTrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
