  userCustomWord   UserCustomWord?              @relation(fields: [userCustomWordId], references: [id], onDelete: Cascade)
  exerciseType     VocabularyExerciseType
  payload          Json
  answerKey        Json
  order            Int
  status           VocabularyTrainingItemStatus @default(PENDING)
  submittedAt      DateTime?
  createdAt        DateTime                     @default(now())

  @@unique([sessionId, order])
  @@index([sessionId, status])
}

model UserVocabularySettings {
