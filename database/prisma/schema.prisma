// Prisma schema for KRIN-EdTech.
// The legacy generic course level is retained only for a lossless migration.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-client-payments-runtime"
}

model User {
  id                            String                       @id @default(cuid())
  email                         String                       @unique
  username                      String                       @unique
  name                          String
  firstName                     String?
  lastName                      String?
  passwordHash                  String
  avatar                        String?
  interfaceLanguage             String                       @default("en")
  timeZone                      String                       @default("UTC")
  country                       String?
  provider                      String?
  providerAccountId             String?
  stripeCustomerId              String?                      @unique
  subscriptionPlan              SubscriptionPlan             @default(FREE)
  subscriptionStatus            SubscriptionStatus           @default(NONE)
  subscriptionCurrentPeriodEnd  DateTime?
  role                          Role                         @default(STUDENT)
  isBlocked                     Boolean                      @default(false)
  deletedAt                     DateTime?
  emailVerified                 Boolean                      @default(false)
  emailVerificationToken        String?
  emailVerificationSentAt       DateTime?
  passwordResetTokenHash        String?                      @unique
  passwordResetExpiresAt        DateTime?
  passwordResetRequestedAt      DateTime?
  targetLanguage                String?
  learningGoal                  String?
  currentLevel                  Level?
  dailyIntensityMinutes         Int?
  dailyGoalMinutes              Int                          @default(15)
  /// Learners opt in to the public leaderboard. Names, emails and other
  /// private profile data are never exposed by leaderboard queries.
  showInLeaderboard             Boolean                      @default(true)
  takePlacementTest             Boolean                      @default(false)
  onboardingCompletedAt         DateTime?
  welcomeBonusPoints            Int                          @default(0)
  guidedTourCompleted           Boolean                      @default(false)
  lastLoginAt                   DateTime?
  lastActiveAt                  DateTime?
  teacherProfile                TeacherProfile?
  ownedLearningGroups           LearningGroup[]              @relation("LearningGroupOwner")
  groupTeachingMemberships      GroupTeacher[]               @relation("GroupTeacherUser")
  groupStudentMemberships       GroupStudent[]               @relation("GroupStudentUser")
  sentGroupInvitations          GroupInvitation[]            @relation("GroupInvitationInviter")
  invitationStudentRecords      GroupInvitation[]            @relation("GroupInvitationStudent")
  studentCourses                StudentCourse[]
  assignedCoursesAsTeacher      StudentCourseAssignment[]    @relation("StudentCourseAssignmentTeacher")
  assignedCoursesAsStudent      StudentCourseAssignment[]    @relation("StudentCourseAssignmentStudent")
  groupCourseAssignments        GroupCourseAssignment[]      @relation("GroupCourseAssignmentAssigner")
  authoredAssignments           Assignment[]                 @relation("AssignmentTeacher")
  assignedAssignments           Assignment[]                 @relation("AssignmentStudent")
  assignmentSubmissions         AssignmentSubmission[]       @relation("AssignmentSubmissionStudent")
  reviewedAssignmentSubmissions AssignmentSubmission[]       @relation("AssignmentSubmissionReviewer")
  teacherNotesWritten           TeacherStudentNote[]         @relation("TeacherStudentNoteTeacher")
  teacherNotesReceived          TeacherStudentNote[]         @relation("TeacherStudentNoteStudent")
  reviewMaterials               AssignmentReviewMaterial[]   @relation("AssignmentReviewMaterialAuthor")
  authoredCourses               Course[]                     @relation("CourseInstructor")
  coursesCreated                Course[]                     @relation("CourseCreatedBy")
  coursesUpdated                Course[]                     @relation("CourseUpdatedBy")
  enrolledCourses               Course[]                     @relation("CourseStudents")
  sessions                      Session[]
  subscriptions                 Subscription[]
  payments                      Payment[]
  orders                        Order[]
  coursePurchases               CoursePurchase[]
  entitlements                  Entitlement[]
  promotionRedemptions          PromotionRedemption[]
  lessonProgress                LessonProgress[]
  exerciseAttempts              ExerciseAttempt[]
  mistakes                      UserMistake[]
  mistakeReviewRuns             MistakeReviewRun[]
  userWords                     UserWord[]
  userCustomWords               UserCustomWord[]
  wordReviewAttempts            WordReviewAttempt[]
  vocabularyTrainingSessions    VocabularyTrainingSession[]
  vocabularySettings            UserVocabularySettings?
  vocabularyImportLogs          VocabularyImportLog[]
  learningActivities            LearningActivity[]
  learningSessions              LearningSession[]
  dailyActivities               UserDailyActivity[]
  experienceTransactions        ExperienceTransaction[]
  wallet                        UserWallet?
  userLevelProgress             UserLevel?
  streak                        UserStreak?
  streakEvents                  StreakEvent[]
  achievements                  UserAchievement[]
  suspiciousActivities          SuspiciousActivity[]
  homeworkSubmissions           HomeworkSubmission[]
  contentAuditLogs              ContentAuditLog[]            @relation("ContentAuditActor")
  notificationSettings          UserNotificationSettings?
  notificationPreferences       UserNotificationPreference[]
  notifications                 Notification[]
  notificationDeliveries        NotificationDelivery[]
  notificationEvents            NotificationEvent[]
  pushSubscriptions             PushSubscription[]
  supportTickets                SupportTicket[]              @relation("SupportTicketRequester")
  assignedSupportTickets        SupportTicket[]              @relation("SupportTicketAssignee")
  supportMessages               SupportMessage[]             @relation("SupportMessageAuthor")
  supportStatusChanges          SupportTicketStatusHistory[] @relation("SupportStatusActor")
  supportAttachments            SupportAttachment[]          @relation("SupportAttachmentUploader")
  supportRatings                SupportRating[]
  searchHistory                 SearchHistory[]
  webVitalMetrics               WebVitalMetric[]
  funnelEvents                  FunnelEvent[]
  helpArticles                  HelpArticle[]                @relation("HelpArticleAuthor")
  announcements                 SystemAnnouncement[]         @relation("AnnouncementAuthor")
  cmsContentVersions            CmsContentVersion[]          @relation("CmsContentVersionActor")
  cmsMediaAssets                CmsMediaAsset[]              @relation("CmsMediaAssetUploader")
  cmsContentSlotsCreated        CmsContentSlot[]             @relation("CmsContentSlotCreator")
  cmsContentSlotsUpdated        CmsContentSlot[]             @relation("CmsContentSlotUpdater")
  cmsExerciseTemplates          CmsExerciseTemplate[]        @relation("CmsExerciseTemplateCreator")
  cmsLessonTemplateSections     CmsLessonTemplateSection[]   @relation("CmsLessonTemplateSectionCreator")
  cmsNotificationReadState      CmsNotificationReadState?    @relation("CmsNotificationReadOwner")
  supportTeamMemberships        SupportTeamMember[]
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  CoinTransaction               CoinTransaction[]

  @@unique([provider, providerAccountId])
  @@index([lastActiveAt])
  @@index([createdAt])
  @@index([deletedAt])
}

model LanguageLevel {
  id              String           @id @default(cuid())
  code            CefrLevel        @unique
  title           String
  description     String
  coverImage      String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  order           Int              @unique
  isPublished     Boolean          @default(false)
  contentStatus   CmsContentStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  archivedAt      DateTime?
  courses         Course[]
  curriculumNodes CurriculumNode[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model CourseCategory {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  description   String
  icon          String?
  coverImage    String?
  order         Int              @unique
  isPublished   Boolean          @default(false)
  contentStatus CmsContentStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?
  courses       Course[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isPublished, order])
}

model Course {
  id                   String                    @id @default(cuid())
  levelId              String
  level                LanguageLevel             @relation(fields: [levelId], references: [id], onDelete: Restrict)
  categoryId           String
  category             CourseCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug                 String                    @unique
  title                String
  shortDescription     String                    @map("description")
  fullDescription      String?
  coverImage           String?
  trailerVideoUrl      String?
  order                Int                       @default(0)
  language             String                    @default("en")
  estimatedDuration    Int                       @default(0)
  lessonCount          Int                       @default(0)
  difficulty           String?
  isPublished          Boolean                   @default(false)
  /// Templates are full course blueprints. They use the same canonical
  /// structure as a course, but must never be discoverable or enrollable.
  isTemplate           Boolean                   @default(false)
  contentStatus        CmsContentStatus          @default(DRAFT)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  archivedAt           DateTime?
  isFeatured           Boolean                   @default(false)
  /// Editorial metadata used by the CMS course-creation wizard. These flags
  /// deliberately live on the canonical course row so catalogue and search
  /// queries never need a second, drifting configuration source.
  courseType           CourseType                @default(STANDARD)
  accessMode           CourseAccessMode          @default(FREE)
  isVisibleInCatalog   Boolean                   @default(true)
  isVisibleInSearch    Boolean                   @default(true)
  isVisibleOnHomepage  Boolean                   @default(false)
  isVisibleInRecommendations Boolean             @default(false)
  isVisibleInLevelBlock Boolean                  @default(true)
  isVisibleInAcademy   Boolean                   @default(true)
  isVisibleInStudentDashboard Boolean            @default(true)
  firstFreeLessonCount Int                       @default(0)
  priceAmount          Int?
  priceCurrency        String                    @default("USD")
  learningOutcomes     Json?
  prerequisites        Json?
  accessPlan           SubscriptionPlan          @default(FREE)
  // Backwards-compatible mapping for the previous three-band curriculum.
  legacyLevel          Level                     @default(BEGINNER) @map("level")
  academySlug          String                    @default("general-english")
  pathSlug             String                    @default("core-journey")
  stageSlug            String                    @default("all-levels")
  instructor           User                      @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId         String
  /// Explicit CMS actor references. `instructor` is the authored-by course
  /// owner, whereas these two fields preserve who created and last edited it.
  createdBy            User                      @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdById          String
  updatedBy            User                      @relation("CourseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  updatedById          String
  students             User[]                    @relation("CourseStudents")
  groupAssignments     GroupCourseAssignment[]
  studentAssignments   StudentCourseAssignment[]
  studentCourses       StudentCourse[]
  assignments          Assignment[]
  modules              CourseModule[]
  learningActivities   LearningActivity[]
  learningSessions     LearningSession[]
  commerceProducts     Product[]
  coursePurchases      CoursePurchase[]
  entitlements         Entitlement[]
  mistakeReviewRuns    MistakeReviewRun[]
  curriculumLinks      CourseCurriculumLink[]
  /// Localized learner-facing copies. The canonical course and its learning
  /// structure remain single rows; translations never create a second course.
  translations         CourseTranslation[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([levelId, isPublished])
  @@index([categoryId, isPublished])
  @@index([levelId, categoryId, order])
  @@index([instructorId, createdAt])
  @@index([createdById, createdAt])
  @@index([updatedById, updatedAt])
  @@index([accessPlan, isPublished])
  @@index([contentStatus, isVisibleInCatalog])
  @@index([contentStatus, isVisibleInSearch])
  @@index([isTemplate, contentStatus])
}

/// CMS-managed locale registry for learner-facing content. Interface strings
/// remain in the i18n bundle; courses and lessons reference these records.
model ContentLocale {
  code                     String                   @id
  displayName              String
  nativeName               String
  isActive                 Boolean                  @default(true)
  order                    Int                      @default(0)
  courseTranslations       CourseTranslation[]      @relation("CourseTranslationLocale")
  moduleTranslations       CourseModuleTranslation[] @relation("CourseModuleTranslationLocale")
  lessonTranslations       LessonTranslation[]      @relation("LessonTranslationLocale")
  lessonBlockTranslations  LessonBlockTranslation[] @relation("LessonBlockTranslationLocale")
  exerciseTranslations     ExerciseTranslation[]    @relation("ExerciseTranslationLocale")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([isActive, order])
}

/// One localized learner-facing presentation per course and locale. Slugs are
/// locale-scoped so public URLs can be localized without URL collisions.
model CourseTranslation {
  id             String           @id @default(cuid())
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  locale         String
  localeRecord   ContentLocale    @relation("CourseTranslationLocale", fields: [locale], references: [code], onDelete: Restrict)
  slug           String
  title          String
  shortDescription String
  fullDescription String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  learningOutcomes Json?
  prerequisites  Json?
  contentStatus  CmsContentStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([courseId, locale])
  @@unique([locale, slug])
  @@index([locale, contentStatus])
  @@index([locale, title])
}

/// Owner-managed level-specific curriculum tree. One table models sections,
/// topics and subtopics without duplicating the existing course hierarchy.
model CurriculumNode {
  id            String             @id @default(cuid())
  levelId       String
  level         LanguageLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        CurriculumNode?    @relation("CurriculumNodeTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      CurriculumNode[]   @relation("CurriculumNodeTree")
  type          CurriculumNodeType
  slug          String
  title         String
  description   String?
  locale        String             @default("en")
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  showOnHomepage Boolean            @default(false)
  showInSearch  Boolean             @default(true)
  order         Int                @default(0)
  contentStatus CmsContentStatus   @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?
  courseLinks   CourseCurriculumLink[]
  translations  CurriculumNodeTranslation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  /// Slugs are unique only within one parent. This permits an editorially
  /// correct tree such as `Grammar → Articles` and `Vocabulary → Articles`
  /// without weakening route resolution, which always scopes by the parent.
  @@unique([levelId, type, parentId, slug])
  @@index([levelId, parentId, type, order])
  @@index([contentStatus, scheduledAt])
}

/// Relational localized copies of a section, topic or subtopic.
model CurriculumNodeTranslation {
  id             String         @id @default(cuid())
  nodeId         String
  node           CurriculumNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  locale         String
  title          String
  description    String?
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([nodeId, locale])
  @@index([locale, title])
}

/// A course may remain level-only (no links), have one primary placement and
/// be related to any number of additional topics/subtopics for discovery.
model CourseCurriculumLink {
  id        String                    @id @default(cuid())
  courseId  String
  course    Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nodeId    String
  node      CurriculumNode            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  relation  CourseCurriculumRelation  @default(RELATED)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([courseId, nodeId])
  @@index([nodeId, relation])
  @@index([courseId, relation])
}

model CourseModule {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  order            Int
  /// Optional modules remain visible but are not counted as required course work.
  isRequired       Boolean          @default(true)
  /// Locks this module until the immediately preceding published module is complete.
  requiresSequentialCompletion Boolean @default(false)
  /// An explicit prerequisite module from the same course, when sequential order
  /// alone is not expressive enough.
  unlockAfterModuleId String?
  unlockAfterModule CourseModule?   @relation("CourseModuleUnlockDependency", fields: [unlockAfterModuleId], references: [id], onDelete: SetNull)
  unlocksModules   CourseModule[]  @relation("CourseModuleUnlockDependency")
  /// Percentage of prerequisite lessons that must be completed to unlock this module.
  requiredCompletionPercent Int     @default(100)
  isPublished      Boolean          @default(false)
  contentStatus    CmsContentStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  archivedAt       DateTime?
  lessons          Lesson[]
  commerceProducts Product[]
  entitlements     Entitlement[]
  translations     CourseModuleTranslation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([courseId, order])
  @@index([courseId, isPublished])
  @@index([courseId, unlockAfterModuleId])
}

model CourseModuleTranslation {
  id           String           @id @default(cuid())
  moduleId     String
  module       CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  locale       String
  localeRecord ContentLocale    @relation("CourseModuleTranslationLocale", fields: [locale], references: [code], onDelete: Restrict)
  title        String
  description  String?
  contentStatus CmsContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([moduleId, locale])
  @@index([locale, contentStatus])
}

model Lesson {
  id                 String                      @id @default(cuid())
  moduleId           String
  module             CourseModule                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// A lesson-level prerequisite. It is deliberately constrained by CMS
  /// services to a preceding lesson in the same module.
  prerequisiteLessonId String?
  prerequisiteLesson   Lesson?                    @relation("LessonPrerequisite", fields: [prerequisiteLessonId], references: [id], onDelete: SetNull)
  unlocksLessons       Lesson[]                   @relation("LessonPrerequisite")
  /// Completion percentage required for the prerequisite lesson before this
  /// lesson may be opened by a learner.
  requiredPrerequisiteCompletion Int              @default(100)
  /// Lets the lesson player offer the next available lesson immediately after
  /// this lesson is completed. It never bypasses the next lesson's own gate.
  autoUnlockNextLesson Boolean                    @default(true)
  slug               String                      @unique
  title              String
  description        String?
  // Preserved so legacy lessons retain their original category.
  type               LessonType
  order              Int
  estimatedDuration  Int                         @default(0)
  phraseOfTheDay     String?
  motivationalQuote  String?
  learningObjectives Json?
  previewText        String?
  isPublished        Boolean                     @default(false)
  contentStatus      CmsContentStatus            @default(DRAFT)
  scheduledAt        DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  isFree             Boolean                     @default(false)
  blocks             LessonBlock[]
  progress           LessonProgress[]
  exerciseAttempts   ExerciseAttempt[]
  mistakes           UserMistake[]
  vocabulary         LessonVocabulary[]
  vocabularySources  UserWord[]                  @relation("UserWordSourceLesson")
  vocabularySessions VocabularyTrainingSession[] @relation("WarmUpLesson")
  learningActivities LearningActivity[]
  learningSessions   LearningSession[]
  assignments        Assignment[]
  grammarTopics      LessonGrammarTopic[]
  translations       LessonTranslation[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([moduleId, order])
  @@index([moduleId, isPublished])
  @@index([moduleId, prerequisiteLessonId])
}

model LessonTranslation {
  id                  String           @id @default(cuid())
  lessonId            String
  lesson              Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  locale              String
  localeRecord        ContentLocale    @relation("LessonTranslationLocale", fields: [locale], references: [code], onDelete: Restrict)
  slug                String
  title               String
  description         String?
  phraseOfTheDay      String?
  motivationalQuote  String?
  learningObjectives Json?
  previewText         String?
  contentStatus       CmsContentStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([lessonId, locale])
  @@unique([locale, slug])
  @@index([locale, contentStatus])
}

model LessonBlock {
  id                  String               @id @default(cuid())
  lessonId            String
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type                LessonBlockType
  title               String?
  content             Json?
  settings            Json?
  order               Int
  isRequired          Boolean              @default(false)
  contentStatus       CmsContentStatus     @default(DRAFT)
  scheduledAt         DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  exercises           Exercise[]
  homeworkSubmissions HomeworkSubmission[]
  translations        LessonBlockTranslation[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([lessonId, order])
  @@index([lessonId, type])
}

/// Text or rich-content overrides for theory and other lesson blocks.
/// Behavioural settings remain on LessonBlock and are never translated.
model LessonBlockTranslation {
  id           String           @id @default(cuid())
  lessonBlockId String
  lessonBlock  LessonBlock      @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)
  locale       String
  localeRecord ContentLocale    @relation("LessonBlockTranslationLocale", fields: [locale], references: [code], onDelete: Restrict)
  title        String?
  content      Json?
  contentStatus CmsContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([lessonBlockId, locale])
  @@index([locale, contentStatus])
}

model GrammarTopic {
  id            String           @id @default(cuid())
  title         String
  slug          String
  cefrLevel     CefrLevel
  description   String?
  order         Int              @default(0)
  contentStatus CmsContentStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?
  rules         GrammarRule[]
  lessonLinks   LessonGrammarTopic[]
  exerciseLinks ExerciseGrammarTopic[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([cefrLevel, slug])
  @@index([cefrLevel, order])
}

/// An editorially managed rule belongs to a CEFR-scoped grammar topic.  The
/// structured fields let the CMS safely render explanations without relying
/// on untrusted HTML.
model GrammarRule {
  id             String       @id @default(cuid())
  grammarTopicId String
  grammarTopic   GrammarTopic @relation(fields: [grammarTopicId], references: [id], onDelete: Cascade)
  title          String
  explanation    String
  examples       Json?
  exceptions     Json?
  commonMistakes Json?
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([grammarTopicId, order])
  @@index([grammarTopicId, title])
}

model Word {
  id                    String              @id @default(cuid())
  lemma                 String
  normalizedLemma       String
  partOfSpeech          WordPartOfSpeech?
  cefrLevel             CefrLevel?
  britishTranscription  String?
  americanTranscription String?
  britishAudioUrl       String?
  americanAudioUrl      String?
  frequencyRank         Int?
  isPhrasalVerb         Boolean             @default(false)
  isIdiomatic           Boolean             @default(false)
  isSlang               Boolean             @default(false)
  isActive              Boolean             @default(true)
  contentStatus         CmsContentStatus    @default(DRAFT)
  scheduledAt           DateTime?
  publishedAt           DateTime?
  archivedAt            DateTime?
  wordFormation         String?
  etymology             String?
  meanings              WordMeaning[]
  userWords             UserWord[]
  lessonVocabulary      LessonVocabulary[]
  sourceRelations       WordRelation[]      @relation("WordRelationSource")
  targetRelations       WordRelation[]      @relation("WordRelationTarget")
  examples              WordExample[]
  collocations          WordCollocation[]
  exerciseLinks         ExerciseVocabulary[]
  reviewAttempts        WordReviewAttempt[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([normalizedLemma, partOfSpeech])
  @@index([normalizedLemma])
  @@index([cefrLevel])
  @@index([partOfSpeech])
}

model WordMeaning {
  id          String   @id @default(cuid())
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  definition  String
  translation String?
  article     String?
  context     String?
  usageLabel  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model WordRelation {
  id           String           @id @default(cuid())
  sourceWordId String
  targetWordId String
  sourceWord   Word             @relation("WordRelationSource", fields: [sourceWordId], references: [id], onDelete: Cascade)
  targetWord   Word             @relation("WordRelationTarget", fields: [targetWordId], references: [id], onDelete: Cascade)
  type         WordRelationType
  note         String?
  createdAt    DateTime         @default(now())

  @@unique([sourceWordId, targetWordId, type])
  @@index([sourceWordId, type])
  @@index([targetWordId, type])
}

model WordExample {
  id          String     @id @default(cuid())
  wordId      String
  word        Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentence    String
  translation String?
  source      String?
  cefrLevel   CefrLevel?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model WordCollocation {
  id          String   @id @default(cuid())
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  value       String
  translation String?
  example     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wordId, order])
  @@index([wordId, order])
}

model LessonVocabulary {
  id         String               @id @default(cuid())
  lessonId   String
  wordId     String
  lesson     Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  word       Word                 @relation(fields: [wordId], references: [id], onDelete: Restrict)
  role       LessonVocabularyRole @default(NEW)
  order      Int
  isRequired Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@unique([lessonId, wordId])
  @@unique([lessonId, order])
  @@index([wordId])
}

/// Relational tags keep a lesson's grammar and vocabulary discoverable for
/// warm-ups, search and reporting. They intentionally replace JSON-only
/// references where filtering is required.
model LessonGrammarTopic {
  id             String       @id @default(cuid())
  lessonId       String
  grammarTopicId String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  grammarTopic   GrammarTopic @relation(fields: [grammarTopicId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([lessonId, grammarTopicId])
  @@index([grammarTopicId])
}

model Exercise {
  id                 String             @id @default(cuid())
  lessonBlockId      String
  lessonBlock        LessonBlock        @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)
  /// A draft successor can supersede an exercise without deleting its attempts,
  /// mistakes or historic analytics.
  previousVersionId  String?
  previousVersion    Exercise?          @relation("ExerciseVersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions       Exercise[]         @relation("ExerciseVersionLineage")
  type               ExerciseType
  engineKey          String             @default("choice")
  variantKey         String?
  instruction        String
  question           String
  content            Json?
  correctAnswer      Json
  alternativeAnswers Json?
  explanation        String?
  hint               String?
  hintsEnabled       Boolean            @default(true)
  difficulty         Int                @default(1)
  basePoints         Int                @default(1)
  timeLimitSeconds   Int?
  solutionCost       Int                @default(0)
  allowInstantCheck  Boolean            @default(true)
  allowExtraExercise Boolean            @default(false)
  contentStatus      CmsContentStatus   @default(DRAFT)
  scheduledAt        DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  order              Int
  attempts           ExerciseAttempt[]
  mistakes           UserMistake[]
  vocabularyLinks    ExerciseVocabulary[]
  grammarLinks       ExerciseGrammarTopic[]
  learningActivities LearningActivity[]
  savedTemplates     CmsExerciseTemplate[] @relation("CmsExerciseTemplateSource")
  translations       ExerciseTranslation[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([lessonBlockId, order])
  @@index([lessonBlockId, type])
  @@index([previousVersionId])
}

/// Localizes learner-facing exercise copy. Answer configuration remains on
/// Exercise so translations cannot silently change scoring semantics.
model ExerciseTranslation {
  id           String           @id @default(cuid())
  exerciseId   String
  exercise     Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  locale       String
  localeRecord ContentLocale    @relation("ExerciseTranslationLocale", fields: [locale], references: [code], onDelete: Restrict)
  instruction  String
  question     String
  content      Json?
  explanation  String?
  hint         String?
  contentStatus CmsContentStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([exerciseId, locale])
  @@index([locale, contentStatus])
}

model ExerciseVocabulary {
  id         String   @id @default(cuid())
  exerciseId String
  wordId     String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([exerciseId, wordId])
  @@index([wordId])
}

model ExerciseGrammarTopic {
  id             String       @id @default(cuid())
  exerciseId     String
  grammarTopicId String
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  grammarTopic   GrammarTopic @relation(fields: [grammarTopicId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([exerciseId, grammarTopicId])
  @@index([grammarTopicId])
}

/// Owner-created reusable exercise configurations. They complement the static
/// engine catalogue and always produce new draft Exercise rows when used.
model CmsExerciseTemplate {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  sourceExerciseId   String?
  sourceExercise     Exercise?    @relation("CmsExerciseTemplateSource", fields: [sourceExerciseId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User         @relation("CmsExerciseTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  type               ExerciseType
  engineKey          String
  variantKey         String?
  instruction        String
  question           String
  content            Json?
  correctAnswer      Json
  alternativeAnswers Json?
  explanation        String?
  hint               String?
  hintsEnabled       Boolean      @default(true)
  difficulty         Int          @default(1)
  basePoints         Int          @default(1)
  timeLimitSeconds   Int?
  solutionCost       Int          @default(0)
  allowInstantCheck  Boolean      @default(true)
  allowExtraExercise Boolean      @default(false)
  isArchived         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([createdById, createdAt])
  @@index([isArchived, updatedAt])
  @@index([sourceExerciseId])
}

/// Owner-defined shelves for reusable lesson blueprints. A section contains
/// references to catalogued lesson templates rather than cloned lesson data.
model CmsLessonTemplateSection {
  id          String                          @id @default(cuid())
  title       String
  description String?
  createdById String
  createdBy   User                            @relation("CmsLessonTemplateSectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       CmsLessonTemplateSectionItem[]
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@index([createdById, createdAt])
  @@index([title])
}

/// The template key is validated against the server-side lesson template
/// catalogue before a reference is created. This avoids copying a blueprint
/// and lets a template be improved centrally while sections remain organised.
model CmsLessonTemplateSectionItem {
  id          String                   @id @default(cuid())
  sectionId   String
  section     CmsLessonTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  templateKey String
  order       Int
  createdAt   DateTime                 @default(now())

  @@unique([sectionId, templateKey])
  @@unique([sectionId, order])
  @@index([templateKey])
}

model LessonProgress {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status            LessonProgressStatus @default(STARTED)
  completedBlocks   Json?
  currentBlockId    String?
  completionPercent Int                  @default(0)
  score             Int                  @default(0)
  grade             Int?
  correctAnswers    Int                  @default(0)
  incorrectAnswers  Int                  @default(0)
  hintsUsed         Int                  @default(0)
  solutionsOpened   Int                  @default(0)
  activeSeconds     Int                  @default(0)
  totalSeconds      Int                  @default(0)
  startedAt         DateTime             @default(now())
  lastSeenAt        DateTime             @default(now())
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId, status])
  @@index([userId, lastSeenAt])
}

model ExerciseAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submittedAnswer  Json
  isCorrect        Boolean
  scoreAwarded     Int      @default(0)
  timeSpentSeconds Int?
  hintUsed         Boolean  @default(false)
  solutionOpened   Boolean  @default(false)
  attemptNumber    Int
  idempotencyKey   String?
  createdAt        DateTime @default(now())

  @@unique([userId, exerciseId, attemptNumber])
  @@unique([userId, exerciseId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([exerciseId, createdAt])
  @@index([lessonId, createdAt])
}

model HomeworkSubmission {
  id            String      @id @default(cuid())
  lessonBlockId String
  lessonBlock   LessonBlock @relation(fields: [lessonBlockId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Json?
  score         Int         @default(0)
  grade         Int?
  status        String      @default("DRAFT")
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([lessonBlockId, userId])
  @@index([userId, status, updatedAt])
}

model UserMistake {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String?
  exercise        Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  lessonId        String?
  lesson          Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  submittedAnswer Json?
  expectedAnswer  Json?
  explanation     String?
  mistakeType     String?
  occurrenceCount Int       @default(1)
  resolutionCount Int       @default(0)
  lastOccurredAt  DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewItems     MistakeReviewRunItem[]

  @@index([userId, resolvedAt, lastOccurredAt])
  @@index([exerciseId, userId])
}

/// A secure, server-owned review queue. It records only mistakes that belong
/// to the learner at the time a review starts, so a client cannot unlock or
/// review arbitrary lessons by crafting a URL.
model MistakeReviewRun {
  id                  String                  @id @default(cuid())
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId            String?
  course              Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  scope               MistakeReviewRunScope   @default(COURSE)
  status              MistakeReviewRunStatus  @default(ACTIVE)
  initialMistakeCount Int
  startedFromLessonId String?
  completedAt         DateTime?
  awardedExperience   Int                     @default(0)
  awardedCoins        Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  items               MistakeReviewRunItem[]

  @@index([userId, status, createdAt])
  @@index([courseId, status])
}

model MistakeReviewRunItem {
  id        String           @id @default(cuid())
  runId     String
  run       MistakeReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  mistakeId String
  mistake   UserMistake      @relation(fields: [mistakeId], references: [id], onDelete: Cascade)
  resolvedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([runId, mistakeId])
  @@index([runId, resolvedAt])
  @@index([mistakeId])
}

model UserWord {
  id                String                   @id @default(cuid())
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId            String?
  word              Word?                    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  customWord        String?
  customTranslation String?
  sourceLessonId    String?
  sourceLesson      Lesson?                  @relation("UserWordSourceLesson", fields: [sourceLessonId], references: [id], onDelete: SetNull)
  status            UserWordStatus           @default(NEW)
  masteryLevel      Int                      @default(0)
  easeFactor        Float                    @default(2.5)
  intervalDays      Int                      @default(0)
  repetitions       Int                      @default(0)
  lapses            Int                      @default(0)
  nextReviewAt      DateTime?
  lastReviewedAt    DateTime?
  correctCount      Int                      @default(0)
  incorrectCount    Int                      @default(0)
  isDifficult       Boolean                  @default(false)
  addedAt           DateTime                 @default(now())
  masteredAt        DateTime?
  archivedAt        DateTime?
  reviewAttempts    WordReviewAttempt[]
  trainingItems     VocabularyTrainingItem[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@index([userId, masteryLevel])
  @@index([wordId])
}

model UserCustomWord {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term           String
  normalizedTerm String
  translation    String
  partOfSpeech   WordPartOfSpeech?
  example        String?
  note           String?
  status         UserWordStatus           @default(NEW)
  masteryLevel   Int                      @default(0)
  easeFactor     Float                    @default(2.5)
  intervalDays   Int                      @default(0)
  repetitions    Int                      @default(0)
  lapses         Int                      @default(0)
  correctCount   Int                      @default(0)
  incorrectCount Int                      @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  masteredAt     DateTime?
  archivedAt     DateTime?
  isDifficult    Boolean                  @default(false)
  reviewAttempts WordReviewAttempt[]
  trainingItems  VocabularyTrainingItem[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([userId, normalizedTerm])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
}

model WordReviewAttempt {
  id                   String                 @id @default(cuid())
  userId               String
  userWordId           String?
  userCustomWordId     String?
  wordId               String?
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord             UserWord?              @relation(fields: [userWordId], references: [id], onDelete: SetNull)
  userCustomWord       UserCustomWord?        @relation(fields: [userCustomWordId], references: [id], onDelete: SetNull)
  word                 Word?                  @relation(fields: [wordId], references: [id], onDelete: SetNull)
  exerciseType         VocabularyExerciseType
  submittedAnswer      Json
  isCorrect            Boolean
  quality              WordReviewQuality
  responseTimeSeconds  Int?
  previousIntervalDays Int
  nextIntervalDays     Int
  previousMasteryLevel Int
  nextMasteryLevel     Int
  reviewedAt           DateTime               @default(now())

  @@index([userId, reviewedAt])
  @@index([userWordId, reviewedAt])
  @@index([userCustomWordId, reviewedAt])
}

model VocabularyTrainingSession {
  id                 String                   @id @default(cuid())
  userId             String
  lessonId           String?
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
