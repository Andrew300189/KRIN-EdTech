  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}

model HelpCategory {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  order       Int           @default(0)
  isActive    Boolean       @default(true)
  articles    HelpArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SearchHistory {
  id              String                 @id @default(cuid())
  userId          String?
  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType       SearchHistoryEventType
  query           String
  normalizedQuery String
  queryHash       String
  context         String
  resultCount     Int?
  tookMs          Int?
  resultType      String?
  resultId        String?
  resultUrl       String?
  position        Int?
  locale          String?
  ipHash          String?
  userAgent       String?
  createdAt       DateTime               @default(now())

  @@index([createdAt])
  @@index([context, createdAt])
  @@index([queryHash, createdAt])
  @@index([userId, createdAt])
}

model SearchQueryMetric {
  id               String   @id @default(cuid())
  day              DateTime
  context          String
  queryHash        String
  totalSearches    Int      @default(0)
  noResultSearches Int      @default(0)
  totalClicks      Int      @default(0)
  lastResultCount  Int      @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([day, context, queryHash])
  @@index([day, context])
  @@index([queryHash, day])
}

/// Lightweight, first-party Core Web Vitals samples. They deliberately store
/// only a route path (never a full URL or query string) and no IP address.
model WebVitalMetric {
  id             String   @id @default(cuid())
  metricId       String   @unique
  name           String
  value          Float
  delta          Float?
  rating         String
  navigationType String?
  pagePath       String
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name, createdAt])
  @@index([pagePath, createdAt])
  @@index([rating, createdAt])
}

/// First-party funnel telemetry. It deliberately stores only a constrained
/// event name, safe navigation context and an optional signed-in user/course
/// reference. It never contains form values, payment details, URLs with
/// queries, IPs or user agents.
model FunnelEvent {
  id           String             @id @default(cuid())
  eventId      String             @unique
  eventType    FunnelEventType
  pagePath     String
  sessionId    String?
  referrerPath String?
  courseId     String?
  levelCode    CefrLevel?
  planCode     String?
  currency     String?
  deviceType   FunnelDeviceType?
  result       FunnelEventResult?
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([eventType, createdAt])
  @@index([pagePath, createdAt])
  @@index([courseId, createdAt])
  @@index([sessionId, createdAt])
  @@index([levelCode, createdAt])
}

model HelpArticle {
