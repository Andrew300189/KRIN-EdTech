// Prisma schema for database
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String     @unique
  name      String
  passwordHash String
  avatar    String?
  role      Role       @default(STUDENT)
  isBlocked Boolean @default(false)
  deletedAt DateTime?
  emailVerified Boolean @default(false)
  emailVerificationToken String?
  emailVerificationSentAt DateTime?
  targetLanguage String?
  learningGoal String?
  currentLevel Level?
  dailyIntensityMinutes Int?
  dailyGoalMinutes Int @default(15)
  takePlacementTest Boolean @default(false)
  onboardingCompletedAt DateTime?
  welcomeBonusPoints Int @default(0)
  guidedTourCompleted Boolean @default(false)
  lastLoginAt DateTime?
  authoredCourses Course[] @relation("CourseInstructor")
  enrolledCourses Course[] @relation("CourseStudents")
  sessions Session[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  isRevoked      Boolean  @default(false)
  revokedAt      DateTime?
  revokedReason  String?

  @@index([userId, isRevoked, expiresAt])
  @@index([expiresAt])
}

model Course {
  id        String     @id @default(cuid())
  title     String
  description String
  level     Level      @default(BEGINNER)
  academySlug String @default("general-english")
  pathSlug String @default("core-journey")
  stageSlug String @default("all-levels")
  instructor User @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId String
  students  User[] @relation("CourseStudents")
  lessons   Lesson[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Lesson {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id])
  title     String
  type      LessonType
  order     Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  READING
  LISTENING
  SPEAKING
  WRITING
  GRAMMAR
  VOCABULARY
}
