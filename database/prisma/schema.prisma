  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([categoryId, priority])
}

model SupportTicket {
  id              String                       @id @default(cuid())
  number          String                       @unique
  userId          String
  user            User                         @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Restrict)
  categoryId      String?
  category        SupportCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedToId    String?
  assignedTo      User?                        @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedTeamId  String?
  assignedTeam    SupportTeam?                 @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  subject         String
  description     String
  priority        SupportTicketPriority        @default(NORMAL)
  status          SupportTicketStatus          @default(OPEN)
  relatedOrderId  String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime                     @default(now())
  messages        SupportMessage[]
  attachments     SupportAttachment[]
  statusHistory   SupportTicketStatusHistory[]
  rating          SupportRating?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([userId, createdAt])
  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([assignedTeamId, status])
  @@index([lastMessageAt])
}

model SupportMessage {
  id          String              @id @default(cuid())
  ticketId    String
  ticket      SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  kind        SupportMessageKind  @default(USER_MESSAGE)
  body        String
  isInternal  Boolean             @default(false)
  attachments SupportAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([ticketId, createdAt])
}

model SupportAttachment {
  id           String          @id @default(cuid())
  ticketId     String
  ticket       SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId    String?
  message      SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User            @relation("SupportAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  originalName String
