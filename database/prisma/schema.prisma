  accessEndsAt   DateTime?
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, courseId, orderId])
  @@index([userId, courseId])
  @@index([status, createdAt])
}

model Entitlement {
  id             String            @id @default(cuid())
