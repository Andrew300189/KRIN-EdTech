  teacher      User                       @relation("StudentCourseAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  groupId      String?
  group        LearningGroup?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
