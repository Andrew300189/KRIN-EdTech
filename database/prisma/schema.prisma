  includedProduct   Product @relation("BundleIncludedProduct", fields: [includedProductId], references: [id], onDelete: Restrict)
  order             Int     @default(0)

  @@unique([bundleProductId, includedProductId])
}

model Order {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  number             String           @unique
  type               OrderType
  status             OrderStatus      @default(CREATED)
  currency           String
  subtotalAmount     Int
  discountAmount     Int              @default(0)
  taxAmount          Int              @default(0)
  totalAmount        Int
  provider           PaymentProvider
  providerCheckoutId String?          @unique
  idempotencyKey     String           @unique
  promotionCode      String?
  metadata           Json?
  items              OrderItem[]
  payments           Payment[]
  purchases          CoursePurchase[]
  entitlements       Entitlement[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  paidAt             DateTime?
  canceledAt         DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerCheckoutId])
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  productPriceId String
  productPrice   ProductPrice @relation(fields: [productPriceId], references: [id], onDelete: Restrict)
  titleSnapshot  String
  quantity       Int          @default(1)
  unitAmount     Int
  totalAmount    Int
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([orderId])
}

model CoursePurchase {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  courseId       String
  course         Course               @relation(fields: [courseId], references: [id], onDelete: Restrict)
  orderId        String
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId      String?
  payment        Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status         CoursePurchaseStatus @default(PENDING)
  accessStartsAt DateTime?
  accessEndsAt   DateTime?
  revokedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([userId, courseId, orderId])
  @@index([userId, courseId])
}

model Entitlement {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  type           EntitlementType
  sourceType     String
  sourceId       String
  idempotencyKey String            @unique
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  courseId       String?
  course         Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  moduleId       String?
  module         CourseModule?     @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  planId         String?
  plan           Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  status         EntitlementStatus @default(ACTIVE)
  startsAt       DateTime          @default(now())
  endsAt         DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([userId, type, sourceType, sourceId, courseId, moduleId, planId])
  @@index([userId, status])
  @@index([userId, courseId])
}

model Refund {
  id               String       @id @default(cuid())
  paymentId        String
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRefundId String?
  amount           Int
  currency         String
  status           RefundStatus @default(PENDING)
  reason           String?
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([paymentId, providerRefundId])
  @@index([paymentId, status])
}

model Promotion {
  id           String                @id @default(cuid())
