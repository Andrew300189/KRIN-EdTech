  @@unique([groupId, teacherId])
  @@index([teacherId, groupId])
}

model GroupStudent {
  id          String             @id @default(cuid())
  groupId     String
  group       LearningGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId   String
