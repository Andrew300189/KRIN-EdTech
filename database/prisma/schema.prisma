  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model SupportTeamMember {
  id        String      @id @default(cuid())
  teamId    String
  team      SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
