  updatedAt DateTime               @updatedAt
}

model SupportTeam {
  id         String              @id @default(cuid())
  slug       String              @unique
  title      String
  isActive   Boolean             @default(true)
  members    SupportTeamMember[]
  tickets    SupportTicket[]
