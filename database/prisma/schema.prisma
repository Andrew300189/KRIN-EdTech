  removedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([groupId, studentId])
  @@index([groupId, status])
  @@index([studentId, status])
}

model GroupInvitation {
  id          String                @id @default(cuid())
